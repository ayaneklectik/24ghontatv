  public function SendFeedback(Request $request)
  {
    $subject        = trim($request->input('subject'));
    $messages        = trim($request->input('message'));
    $user_name      = trim($request->input('user_name'));
    $user_last_name = trim($request->input('user_last_name'));
    $gender         = trim($request->input('gender'));
    $email          = trim($request->input('email'));
    $city           = trim($request->input('city'));
    $country        = trim($request->input('country'));

    $send_mail = "weurobdnews@gmail.com";

    Mail::to($send_mail)->send(new FeedbackMail(
      $subject,
      $messages,
      $user_name,
      $user_last_name,
      $gender,
      $email,
      $city,
      $country,
    ));

    return redirect()->route('home')
      ->with('massage', 'Send Your Feedback Successfully')
      ->with('msg_type', 'success');
  }

