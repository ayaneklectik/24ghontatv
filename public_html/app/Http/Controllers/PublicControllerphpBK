  public function searchNews(Request $request)
  {

    $searchText = $request->get('search','');
    // return $searchText;
    
    $data['media'] = SocialMedia::find(1);
    $data['footer'] = FooterContent::find(1);
    $data['app'] = App_setting::find(1);
    $data['video_link'] = LiveVideo::select('*')->where('id', 1)->first();
    
    $data['all_cat_news'] = NewsTable::select('*')
    ->when($searchText,function($query) use($searchText) {
        return $query->where('news_title','like',"%{$searchText}%");
    })
    ->where(['status' => 1])
    ->orderBy('created_at', 'DESC')
    ->paginate(15);
    
    $data['cat'] = Category::select('*')->first();
    $data['sub_cats'] = SubCategory::select('*')->get();
    $data['nav_cats'] = Category::select('*')->where('status', 1)->inRandomOrder()->limit(10)->get();
    $data['remaining_categories'] = Category::select('*')->where('status', 1)->inRandomOrder()->offset(10)->limit(PHP_INT_MAX)->get();
    $data['cats'] = Category::select('*')->where('status', 1)->inRandomOrder()->get();

    $cat_lead_news_max_id = NewsTable::where(['status' => 1])
    ->when($searchText,function($query) use($searchText) {
        return $query->where('news_title','like',"%{$searchText}%");
    })
    ->orderBy('id', 'desc')->first();


    if ($cat_lead_news_max_id) {
      $data['cat_lead_news_1'] = NewsTable::where([ 'status' => 1])
      ->when($searchText,function($query) use($searchText) {
            return $query->where('news_title','like',"%{$searchText}%");
        })
        ->where('id', '!=', $cat_lead_news_max_id->id)
        ->orderBy('id', 'desc')->limit(1)->get();
    } else {
      $data['cat_lead_news_1'] = []; // or [] if using array
    }

    $data['cat_lead_news_2'] = NewsTable::select('*')->where(['status' => 1])
    ->when($searchText,function($query) use($searchText) {
        return $query->where('news_title','like',"%{$searchText}%");
    })
    ->inRandomOrder()->offset(1)->limit(2)->get();
    $data['cat_lead_news_3'] = NewsTable::select('*')->where([ 'status' => 1])
    ->when($searchText,function($query) use($searchText) {
        return $query->where('news_title','like',"%{$searchText}%");
    })
    ->inRandomOrder()->offset(3)->limit(3)->get();
    $data['cat_lead_news_4'] = NewsTable::select('*')->where([ 'status' => 1])
    ->when($searchText,function($query) use($searchText) {
        return $query->where('news_title','like',"%{$searchText}%");
    })
    ->inRandomOrder()->offset(5)->limit(10)->get();
    $data['populer'] = NewsTable::select('*')->where(['status' => 1])
    ->when($searchText,function($query) use($searchText) {
        return $query->where('news_title','like',"%{$searchText}%");
    })
    ->inRandomOrder()->limit(20)->get();

    return view('frontend.search-category-news', $data);
  }

