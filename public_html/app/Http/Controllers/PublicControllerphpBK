        $data['nextNews'] = NewsTable::where('id',  $id)->orderBy('id')->first();
        $nextNews = NewsTable::where('id', $id)->orderBy('id')->first();
        $nextNewsLink = NewsTable::find($nextNews->id);
        $data['nextNewsLink'] = $nextNewsLink->title_link;
      } else {
        $data['nextNews'] = NewsTable::where('id', '>', $id)->orderBy('id')->first();
        $nextNews = NewsTable::where('id', '>', $id)->orderBy('id')->first();
        $nextNewsLink = NewsTable::find($nextNews->id);
        $data['nextNewsLink'] = $nextNewsLink->title_link;
      }

      $previousNews = NewsTable::where('id', '<', $id)->orderBy('id', 'desc')->first();
      if (empty($previousNews->id)) {
        $data['previousNews'] = NewsTable::where('id', $id)->orderBy('id', 'desc')->first();
