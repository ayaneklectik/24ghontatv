        $data['previousNews'] = NewsTable::where('id', '<', $id)->orderBy('id', 'desc')->first();
        $previousNews = NewsTable::where('id', '<', $id)->orderBy('id', 'desc')->first();
        $previousNewsLink = NewsTable::find($previousNews->id);
        $data['previousNewsLink'] = $previousNewsLink->title_link;
      }

      return view('frontend.news_details', $data);
    } else {
      return redirect()->route('page-not-found');
    }
