NODE_ENV=production

# NextAuth / Auth.js
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=https://www.example.com

# Public browser URL
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Laravel server-to-server base URL (without /api/v1)
LARAVEL_BASE_URL=https://api.example.com

# Laravel authenticated admin BFF target
LARAVEL_API_URL=https://api.example.com/api/v1/admin

# Laravel public API target
LARAVEL_PUBLIC_API_URL=https://api.example.com/api/v1

NEXT_PUBLIC_MEDIA_BASE_URL=https://api.24ghontatv.com
